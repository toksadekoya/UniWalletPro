{
  "name": "uniwalletpro",
  "version": "3.0.0",
  "private": true,
  "description": "A private, accessible budgeting dashboard for students",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:unit": "vitest run tests/unit tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "keywords": [
    "accessibility",
    "budget",
    "chartjs",
    "finance",
    "student"
  ],
  "author": "Adetokunbo Adekoya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toksadekoya/UniWalletPro.git"
  },
  "bugs": {
    "url": "https://github.com/toksadekoya/UniWalletPro/issues"
  },
  "homepage": "https://toksadekoya.github.io/UniWalletPro/",
  "dependencies": {
    "chart.js": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
